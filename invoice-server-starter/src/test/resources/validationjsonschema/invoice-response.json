{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "InvoiceResponse Schema",
  "description": "Schema for Invoice API response",
  "properties": {
    "id": {
      "type": "integer",
      "description": "Unique identifier"
    },
    "invoiceNumber": {
      "type": "integer",
      "minimum": 1
    },
    "issued": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "dueDate": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "product": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "price": {
      "type": "integer",
      "minimum": 1
    },
    "vat": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "note": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "buyer": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "identificationNumber": {
          "type": "string",
          "pattern": "^[0-9]{8}$"
        }
      },
      "required": [
        "id",
        "identificationNumber"
      ],
      "additionalProperties": true
    },
    "seller": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "identificationNumber": {
          "type": "string",
          "pattern": "^[0-9]{8}$"
        }
      },
      "required": [
        "id",
        "identificationNumber"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "id",
    "invoiceNumber",
    "issued",
    "dueDate",
    "product",
    "price",
    "vat",
    "buyer",
    "seller"
  ],
  "additionalProperties": false
}